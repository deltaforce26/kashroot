# Copy to .env and adjust. Never commit .env.
KASHROOT_ENV=local
KASHROOT_DATABASE_URL=postgresql+psycopg://kashroot:kashroot@localhost:5432/kashroot
KASHROOT_REDIS_URL=redis://localhost:6379/0

# Evidence photos (S3-compatible). Local dev can point at MinIO.
KASHROOT_S3_ENDPOINT_URL=http://localhost:9000
KASHROOT_S3_BUCKET=kashroot-evidence
KASHROOT_S3_ACCESS_KEY=
KASHROOT_S3_SECRET_KEY=

# Default certifier staleness window in days (see data/README.md).
KASHROOT_DEFAULT_FRESHNESS_DAYS=90
