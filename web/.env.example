# Copy the parts you need into `web/.env.local` (gitignored). Never commit a key.

# Which API implementation the app talks to.
#   live — /v1/... through the Vite dev proxy to FastAPI on :8000. Committed default.
#   mock — the fixture server in src/api/mock/, which needs no backend at all.
# Flipping this one line runs the entire demo without a database, which is the
# fallback if the API is down.
VITE_API_MODE=live

# Google Maps JavaScript API browser key, for the map screen.
#
# This must be a SEPARATE, referrer-restricted BROWSER key. The server-side
# Geocoding key in the repo root .env is never read by the client and must never be
# copied here — anything in a client bundle is published to the world.
#
# Leave it unset and the map screen falls back to the design's striped placeholder
# with a short explanation; every other screen is unaffected.
VITE_GOOGLE_MAPS_BROWSER_KEY=
